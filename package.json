  "keywords": [
    "joplin-plugin",
    "joplin",
    "recovery"
  ],
  "author": "mrjo118",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.7.13",
    "copy-webpack-plugin": "^11.0.0",
    "ts-loader": "^9.3.1",
    "typescript": "^4.8.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
