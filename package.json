{
  "name": "joplin-orphaned-note-and-conflict-repair-tool",
  "version": "1.0.0",
  "description": "Find and recreate notebooks referenced by orphaned Joplin items, and move conflicts for deleted notes back to their original notebooks.",
  "main": "dist/index.js",
  "files": [
    "publish/"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "dist": "npm run build && node scripts/dist.js",
